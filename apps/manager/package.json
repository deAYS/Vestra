{
  "name": "@vestra/manager",
  "version": "0.1.0-alpha.4",
  "private": true,
  "type": "module",
  "description": "Vestra Manager — Discord installation management GUI (Electron).",
  "license": "MIT",
  "author": "Vestra contributors",
  "main": "./dist/main/index.js",
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "build:dev": "node ./scripts/build.mjs --dev",
    "dev": "node ./scripts/build.mjs --dev && electron .",
    "test": "bun test ./test",
    "package": "electron-builder --config electron-builder.yml --win --publish never"
  },
  "devDependencies": {
    "@vestra/installer": "workspace:*",
    "@vestra/shared": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "electron": "^34.5.0",
    "electron-builder": "26.15.3",
    "happy-dom": "^17.4.0"
  }
}
