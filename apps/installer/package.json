{
  "name": "@vestra/installer",
  "version": "0.1.0-alpha.5",
  "type": "module",
  "main": "./src/index.ts",
  "bin": {
    "vestra": "./dist/vestra.mjs"
  },
  "scripts": {
    "build": "esbuild ./src/index.ts --bundle --platform=node --format=esm --external:original-fs --external:electron --outfile=./dist/installer.mjs; esbuild ./src/bin.ts --bundle --platform=node --format=esm --external:original-fs --external:electron --outfile=./dist/vestra.mjs --banner:js=\"#!/usr/bin/env node\""
  },
  "dependencies": {
    "@vestra/injector": "workspace:*",
    "@vestra/shared": "workspace:*"
  }
}
