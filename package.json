{
  "name": "vestra-client",
  "private": true,
  "version": "0.0.0",
  "description": "Vestra — Your Discord. Your rules.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bun run --filter './packages/*' --filter './apps/*' build",
    "dev": "bun --watch packages/core/src/index.ts",
    "manager:dev": "bun --cwd apps/manager dev",
    "manager:build": "bun --cwd apps/manager build",
    "manager:test": "bun test apps/manager"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  }
}
